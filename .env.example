# PrintFlow - Autonomous Walk-in Print Shop Automation System
# Root Environment Configuration Baseline

APP_NAME=PrintFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Application Edition: standalone or saas
# Locked Architectural Decision 5: Standalone mode first
APP_EDITION=standalone

# Regional Defaults (Locked Architectural Decision 1)
APP_CURRENCY=BDT
APP_LOCALE_BD=bn_BD
APP_COUNTRY=BD

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=printflow
DB_USERNAME=printflow
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CACHE_PREFIX=printflow_cache

# Queue (Redis-backed prioritized workers)
QUEUE_CONNECTION=redis

# Redis 7
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=redispassword
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Storage (MinIO S3 Compatible Object Storage)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=printflow_admin
AWS_SECRET_ACCESS_KEY=printflow_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=printflow-storage
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Laravel Reverb (WebSockets)
REVERB_APP_ID=printflow_reverb
REVERB_APP_KEY=printflow_key
REVERB_APP_SECRET=printflow_secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Mail (Mailpit for local development)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@printflow.local"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway: SSLCOMMERZ v4
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_IS_LOCALHOST=true

# Payment Gateway: bKash Tokenized Checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MODE=sandbox

# Local Port Mappings for Docker Compose
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001
FORWARD_MAILPIT_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025
FORWARD_REVERB_PORT=8080
FORWARD_FRONTEND_PORT=5173
FORWARD_HTTP_PORT=80
FORWARD_HTTPS_PORT=443

# Frontend Variables
VITE_API_URL=http://localhost/api/v1
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="8080"
VITE_REVERB_SCHEME="http"
